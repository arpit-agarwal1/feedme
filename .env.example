# Supabase — from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — https://resend.com (free tier: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Your personal email for the morning digest
DIGEST_TO_EMAIL=you@gmail.com
DIGEST_FROM_EMAIL=feed@yourdomain.com

# Secret to protect cron endpoints (any random string)
CRON_SECRET=your-random-secret-here
